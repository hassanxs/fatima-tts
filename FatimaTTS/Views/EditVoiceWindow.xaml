<Window x:Class="FatimaTTS.Views.EditVoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Voice"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgContentBrush}"
        FontFamily="Segoe UI">
    <StackPanel Margin="22">
        <TextBlock Text="Edit Voice"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,16"/>

        <TextBlock Text="Display Name" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBox x:Name="NameBox" Style="{StaticResource InputStyle}"
                 Height="34" Margin="0,4,0,12"/>

        <TextBlock Text="Description" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBox x:Name="DescBox" Style="{StaticResource InputStyle}"
                 MinHeight="60" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" Margin="0,4,0,12"/>

        <TextBlock Text="Tags (comma-separated)" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBox x:Name="TagsBox" Style="{StaticResource InputStyle}"
                 Height="34" Margin="0,4,0,12"/>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Gender" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ComboBox x:Name="GenderCombo" Style="{StaticResource ComboStyle}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Age Group" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ComboBox x:Name="AgeCombo" Style="{StaticResource ComboStyle}" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Categories (comma-separated)" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBlock Text="Valid: companions, developer_assistants, education_training, enterprise, healthcare, interactive_media"
                   FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                   TextWrapping="Wrap" Margin="0,2,0,4"/>
        <TextBox x:Name="CategoriesBox" Style="{StaticResource InputStyle}"
                 Height="34" Margin="0,0,0,4"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                    Height="34" Padding="16,0" Click="Cancel_Click"/>
            <Button Content="Save Changes" Style="{StaticResource CtaButtonStyle}"
                    Height="34" Width="130" Margin="8,0,0,0" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
